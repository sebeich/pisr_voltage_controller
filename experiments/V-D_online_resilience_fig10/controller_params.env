# Shared controller/OPF tuning defaults for routed stack
# Override any value by exporting it before running run_routed_stack.sh

: "${P_WEIGHT:=30.0}"
: "${Q_WEIGHT:=1.0}"
: "${PENALTY_W:=1.0e10}"

: "${PLIMIT:=0.3}"
: "${QLIMIT:=0.1}"

# Voltage band used across controllers
: "${COMMON_V_LIMIT:=1.05}"
: "${VMAX:=${COMMON_V_LIMIT}}"
: "${VMIN:=0.97}"

# OPF smoothing / activation
: "${OPF_V_HYST_ON_PU:=0.001}"
: "${OPF_V_HYST_OFF_PU:=0.0002}"
: "${OPF_DP_STEP_LIMIT_MW:=0.03}"
: "${OPF_DQ_STEP_LIMIT_MVAR:=0.01}"
: "${OPF_MOD_ALPHA:=0.7}"

# Sensitivity controller absolute bounds (kept aligned with PLIMIT/QLIMIT)
: "${DELTA_P_LIMIT_MW:=${PLIMIT}}"
: "${DELTA_Q_LIMIT_MVAR:=${QLIMIT}}"

# Optimizer (BlackBoxOptim DE) wall-clock budget per control step, shared by PISR and sensitivity
# controller so that one optimization fits into the 100 ms control period.
: "${GLOB_MAXTIME:=0.05}"

export P_WEIGHT Q_WEIGHT PENALTY_W GLOB_MAXTIME
export PLIMIT QLIMIT
export COMMON_V_LIMIT VMAX VMIN
export OPF_V_HYST_ON_PU OPF_V_HYST_OFF_PU OPF_DP_STEP_LIMIT_MW OPF_DQ_STEP_LIMIT_MVAR OPF_MOD_ALPHA
export DELTA_P_LIMIT_MW DELTA_Q_LIMIT_MVAR
